# Production .env template for Hostinger Business shared hosting.
# Copy this to `.env` on the server (see DEPLOYMENT.md) and fill in the
# blanks. Shared hosting has no Redis and no persistent worker/WebSocket
# process, so cache/session/queue use the `database` driver and
# broadcasting is disabled (BROADCAST_CONNECTION=log) unless you point it
# at a hosted service like Pusher.

APP_NAME="Play Snooker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://playsnooker.bet

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (fill in from hPanel > Databases > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# No persistent worker on shared hosting: queued jobs are drained by a
# Cron Job running `queue:work --stop-when-empty` every minute (see
# DEPLOYMENT.md step 12) rather than a long-running daemon.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@playsnooker.bet"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Play Snooker platform configuration ---
PLATFORM_BASE_CURRENCY=USD
PLATFORM_SUPPORTED_CURRENCIES=USD,GBP,EUR,NGN,BTC,USDT

OPEN_EXCHANGE_RATES_APP_ID=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Reverb/WebSockets require a persistent process and are NOT supported on
# shared hosting. Leave these blank (BROADCAST_CONNECTION=log above keeps
# the app fully functional without live push updates), or point them at a
# hosted Pusher-compatible service if you upgrade later.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

PLATFORM_ESCROW_FEE_PERCENT=5
PLATFORM_TOURNAMENT_HOSTING_FEE=10
PLATFORM_REFERRAL_REWARD_AMOUNT=5

# Generate on the server with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
